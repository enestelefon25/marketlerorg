<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Marketler" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
    </style>

    <!-- Açılış ekranı (Android 12+ yerel splash API, 7–11 için androidx uyumluluk katmanı) -->
    <style name="Theme.Marketler.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Marketler</item>
    </style>
</resources>
