<?xml version="1.0" encoding="utf-8"?>
<!-- Ortak manifest: INTERNET izni BURADA YOK. "mock" sürümü ağa hiç çıkamaz.
     "yerel" ve "canli" sürümleri izni ve ağ güvenlik ayarını kendi klasörlerindeki (src/yerel, src/canli) manifestle ekler.
     usesCleartextTraffic=false: şifresiz (HTTP) trafik varsayılan olarak kapalı. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MarketlerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Marketler"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">
        <!-- Düzeltme (FAZ 2.1, telefonda bildirilen hata): targetSdk 36 ile Android 16'da "öngörülü geri" hareketi
             varsayılan olarak açık; ekran kenarından kaydırınca TÜM sayfa parmağı izleyip sağa sola kayar.
             Bildirilen "tüm sayfa sağa sola kayıyor" sorununun en olası nedeni bu. Klasik geri davranışına dönüldü. Eski sürümlerde bu öznitelik yok sayılır. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Marketler.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
